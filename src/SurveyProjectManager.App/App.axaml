<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SurveyProjectManager.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CFCFCF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EEF5FB" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0F6CBD" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F6CBD" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0C5CA3" />
      <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.ltr">
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
  </Application.Styles>
</Application>
